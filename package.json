{
  "name": "agent-souq",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "packageManager": "npm@11.9.0",
  "overrides": { "postcss": "8.5.17" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
